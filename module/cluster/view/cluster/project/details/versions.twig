{% do headTitle().append(translate("txt-admin") ) %}
{% do headTitle().append(project.name) %}
{% import 'cluster/partial/project/details-formatters' as details %}

<h1>{{ project.name }}</h1>

<p>Versions</p>

{% include 'cluster/partial/project/details-navigation' with {'navigation': navigation} %}

{% for group in groups %}
    <h2>{{ group.title }}</h2>

    <table class="table table-striped table-sm table-hover">
        <thead>
        <tr>
            <th>{{ translate('txt-id') }}</th>
            <th>{{ translate('txt-identifier') }}</th>
            <th>{{ translate('txt-project-status') }}</th>
            <th>Submission date</th>
            <th>Review date</th>
            <th>Countries</th>
            <th>{{ translate('txt-latest-version-costs') }}</th>
            <th>{{ translate('txt-latest-version-effort') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for row in group.rows %}
            <tr>
                <td><small class="text-muted">{{ row.id }}</small></td>
                <td class="font-monospace">{{ row.identifier }}</td>
                <td>{{ row.status }}</td>
                <td>{{ details.date(row.submissionDate) }}</td>
                <td>{{ details.date(row.reviewDate) }}</td>
                <td>{{ row.countries ? row.countries|join(', ') : details.notProvided() }}</td>
                <td class="font-monospace">{{ details.number(row.costs) }}</td>
                <td class="font-monospace">{{ details.number(row.effort) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% else %}
    {{ lbs5alert().info(translate("txt-no-projects-found"))|raw }}
{% endfor %}
