{% do headTitle().append(translate("txt-admin")) %}
{% do headTitle().append(translate("txt-storage-location-list")) %}

<h1>{{ translate("txt-storage-location-list") }} {{ storageLocationLink(null,'new', 'button') }}</h1>

{% do form.prepare() %}
{{ form().openTag(form)|raw }}

<div class="row">
    <div class="col-md-6">
        <p class="lead">{{ translate("txt-storage-location-list-explanation") }}</p>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            {{ formelement(form.get('query')) }}
            {{ formelement(form.get('search')) }}
            {{ formelement(form.get('reset')) }}
        </div>
    </div>
</div>

{% if paginator.pageRange > 0 %}
    <table class="table table-hover table-striped table-sm">
        <thead>
        <tr>
            <th>{{ translate("txt-id") }}</th>
            <th>{% include 'application/partial/filter-table-header' with {'route': 'zfcadmin/reporting/storage-location/list', 'criteria': 'name', 'text': translate("txt-name")} %}</th>
            <th>{% include 'application/partial/filter-table-header' with {'route': 'zfcadmin/reporting/storage-location/list', 'criteria': 'container', 'text': translate("txt-storage-container")} %}</th>
            <th>{% include 'application/partial/filter-table-header' with {'route': 'zfcadmin/reporting/storage-location/list', 'criteria': 'folder', 'text': translate("txt-folder")} %}</th>
            <th>{% include 'application/partial/filter-table-header' with {'route': 'zfcadmin/reporting/storage-location/list', 'criteria': 'file-type', 'text': translate("txt-file-type")} %}</th>

        </tr>
        </thead>
        <tbody>
        {% for storageLocation in paginator.getCurrentItems() %}
            <tr>
                <td><small class="text-muted">{{ storageLocation.id }}</small></td>
                <td>{{ storageLocationLink(storageLocation,'view', 'name') }} {{ storageLocationLink(storageLocation,'edit', 'icon') }}</td>
                <td>{{ storageLocation.container }}</td>
                <td>{{ storageLocation.folder }}</td>
                <td>{{ translate(storageLocation.exportFileType.toString()) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% include 'application/partial/pagination-control' with {'paginator': paginator} %}
{% else %}
    {{ lbs5alert().info(translate("txt-no-storage-locations-found"))|raw }}
{% endif %}

{{ form().closeTag()|raw }}