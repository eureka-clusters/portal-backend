{% do headTitle().append(translate("txt-admin") ) %}
{% do headTitle().append(translate("txt-update-client-secret-oauth2-service-title")) %}

<h1>{{ translate("txt-update-client-secret-oauth2-service-title") }}</h1>
<p>{{ translate("txt-update-client-secret-oauth2-service-explanation") }}</p>

{% do form.prepare() %}
{{ form().openTag(form)|raw }}

{{ lbs5formelement(form.get('clientSecret')) }}
{{ lbs5formelement(form.get('clientSecretVerify')) }}

<div class="row mb-3">
    <div class="offset-sm-3 col-sm-9">
        {{ formelement(form.get('csrf')) }}
        {{ lbs5formelement(form.get('submit')) }}
        {{ lbs5formelement(form.get('cancel')) }}
    </div>
</div>

{{ form().closeTag()|raw }}