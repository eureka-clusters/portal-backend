{
  "name": "eureka-clusters/portal-backend",
  "description": "Backend code for Eureka Clusters PA Portal",
  "version": "1.1",
  "license": "MIT",
  "authors": [
    {
      "name": "Johan van der Heide",
      "email": "info@jield.nl"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.4",
    "laminas/laminas-cli": "^1.14",
    "laminas/laminas-mvc": "^3.9",
    "laminas/laminas-session": "^2.27",
    "laminas/laminas-serializer": "^2.18",
    "laminas/laminas-paginator": "~2.23",
    "laminas/laminas-mvc-plugin-flashmessenger": "^1.12",
    "laminas/laminas-mvc-plugin-identity": "^1.8",
    "laminas/laminas-cache-storage-adapter-redis": "^2.10",
    "laminas/laminas-config-aggregator": "^1.20",
    "jield-webdev/laminas-psr-doctrine-error-hero-module": "dev-develop",
    "jield-webdev/jield-api-tools": "^1.1",
    "phpoffice/phpspreadsheet": "^5.3.0",
    "lm-commons/lmc-cors": "^1.7",
    "league/oauth2-client": "dev-master",
    "eluceo/ical": "^2.2",
    "doctrine/doctrine-orm-module": "^6.4",
    "gedmo/doctrine-extensions": "^3.12",
    "beberlei/doctrineextensions": "^1.5",
    "jield-webdev/laminas-bootstrap5": "dev-develop",
    "jield-webdev/jield-export": "^4.0",
    "mailjet/mailjet-apiv3-php": "^1.6",
    "sendgrid/sendgrid": "^8.1",
    "ext-zip": "*",
    "ext-openssl": "*",
    "ext-intl": "*",
    "ext-PDO": "*",
    "ext-gettext": "*",
    "ext-redis": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "iteaoffice/testing": "^5.1-dev"
  },
  "bin": [
    "bin/generate_templatemaps"
  ],
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Admin\\": "module/admin/src/",
      "Api\\": "module/api/src/",
      "Application\\": "module/application/src/",
      "Cluster\\": "module/cluster/src/",
      "Reporting\\": "module/reporting/src/",
      "Deeplink\\": "module/deeplink/src/",
      "Mailing\\": "module/mailing/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AdminTest\\": "module/admin/test",
      "ApiTest\\": "module/api/test",
      "ApplicationTest\\": "module/application/test",
      "ClusterTest\\": "module/cluster/test",
      "ReportingTest\\": "module/reporting/test",
      "DeeplinkTest\\": "module/deeplink/test",
      "MailingTest\\": "module/mailing/test"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev",
      "dev-develop": "1.1-dev"
    }
  },
  "scripts": {
    "check": [
      "@cs",
      "@php-lint",
      "@phpstan"
    ],
    "fix": [
      "@cbf",
      "@cs-fix"
    ],
    "php-lint": "parallel-lint module",
    "phpstan": "phpstan analyze --memory-limit=2G",
    "cs": "phpcs --extensions=php module",
    "cbf": "phpcbf --extensions=php module",
    "cs-fix": "php-cs-fixer fix --allow-risky=yes",
    "test": "phpunit"
  }
}
